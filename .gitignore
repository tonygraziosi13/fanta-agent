# Ambiente e Sicurezza
.env
.env.*
*.pem
keys/

# IDE e Sistema Operativo
.DS_Store
.vscode/
.idea/

# Dipendenze
node_modules/

# Bytecode Python: rigenerato a ogni esecuzione della pipeline, e legato alla
# versione dell'interprete di chi l'ha lanciata.
__pycache__/
*.pyc

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Build nativi (managed workflow: rigenerati da prebuild)
android/
ios/

# Cache della pipeline dataset: risposte HTTP grezze delle fonti esterne.
# Rigenerabile e pesante — ma NON cancellarla a cuor leggero: senza, la
# generazione ribussa un migliaio di volte ai siti da cui legge.
.cache/

# Log e cache
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
.jest/
coverage/

# NOTA: assets/data/listone.csv e' versionato di proposito.
# E' un artefatto generato ma deterministico, ed e' l'unica fonte dati
# dell'app al primo avvio: senza, il bootstrap (US7) fallisce.
#
# Uscita delle esecuzioni parziali (--only / --limit): e' una prova, non un
# rilascio, e non deve finire nel repo ne' essere scambiata per il dataset vero.
dataset/preview/

# NOTA: anche dataset/ e' versionato di proposito, ma per un'altra ragione:
# non e' un asset dell'app, e' cio' che viene *pubblicato*. GitHub Pages serve
# la radice di main, quindi il commit e' il rilascio (US19-4).
