# Chiavi Groq per il copilota d'asta.
#
# Copia questo file in `.env` (gitignorato) e incolla le tue chiavi.
# `.env` NON va mai committato: questo repository e' pubblico, e una chiave
# finita in un commit viene raccolta dai bot in pochi minuti.
#
#   cp .env.example .env
#
# Piu' chiavi separate da virgola: il piano gratuito di Groq esaurisce in fretta
# il rate limit, e il client ne cambia una all'altra da solo quando arriva un 429.
EXPO_PUBLIC_GROQ_API_KEYS=gsk_primachiave,gsk_secondachiave

# Facoltativi: i modelli. Groq li dismette con poco preavviso, quindi si
# sovrascrivono da qui senza toccare il codice.
# EXPO_PUBLIC_GROQ_MODEL_COMPLEX=llama-3.3-70b-versatile
# EXPO_PUBLIC_GROQ_MODEL_FAST=llama-3.1-8b-instant
