{
  "name": "fanta-agent",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "listone": "python scripts/refresh_listone.py",
    "listone:xlsx": "python scripts/xlsx_to_csv.py",
    "dataset": "python scripts/build_dataset.py",
    "coaches": "python scripts/build_coaches.py",
    "asta": "python scripts/fetch_asta.py",
    "postinstall": "node scripts/ensure_seed.js",
    "prestart": "node scripts/ensure_seed.js",
    "dataset:test": "python -m unittest discover -s scripts -p \"test_*.py\""
  },
  "dependencies": {
    "@shopify/flash-list": "2.0.2",
    "expo": "~54.0.7",
    "expo-asset": "~12.0.7",
    "expo-constants": "~18.0.8",
    "expo-file-system": "~19.0.14",
    "expo-router": "~6.0.4",
    "expo-splash-screen": "~31.0.10",
    "expo-sqlite": "~16.0.8",
    "expo-status-bar": "~3.0.8",
    "papaparse": "^5.5.3",
    "react": "19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "^0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/papaparse": "^5.3.16",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.0",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/"
    ]
  }
}
